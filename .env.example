AWS_REGION=eu-west-1
# AWS Academy often: us-east-1

# Kinesis — raise shards for high scale
KINESIS_STREAM=wikimedia-stream
KINESIS_SHARDS=4

# S3 bucket names (must be globally unique — shared project names, no personal IDs)
S3_RAW=wikimedia-analytics-raw
S3_BATCH=wikimedia-analytics-batch
S3_RAW_PREFIX=data/
S3_BATCH_PREFIX=output/

# DynamoDB speed view
DYNAMO_TABLE=wikimedia-speed-view

# EMR (set after infra/setup.py)
EMR_CLUSTER_ID=j-XXXXXXXXXXXX
EMR_MIN_INSTANCES=2
EMR_MAX_INSTANCES=8

# Athena / serving
ATHENA_DB=wikimedia_pipeline
ATHENA_TABLE=batch_view
ATHENA_KEYWORDS_TABLE=batch_keywords
ATHENA_HOURLY_TABLE=batch_hourly
S3_ATHENA_OUT=s3://wikimedia-analytics-batch/athena-results/

# Ingestion
DATA_SOURCE=wikimedia
REPLAY_FILE=data/sample_events.jsonl
REPLAY_RATE_HZ=10
WIKIMEDIA_URL=https://stream.wikimedia.org/v2/stream/recentchange

# Speed layer
WINDOW_SECONDS=300
TOP_N=10

# Raw S3 dual-write (larger buffers for high scale)
S3_RAW_FLUSH_SIZE=200
S3_RAW_FLUSH_SECONDS=5

# High-scale ingest (EC2 producer)
INGEST_FANOUT=8
INGEST_SYNTH_HZ=150
INGEST_WORKERS=4
KINESIS_PUT_BATCH=25

# Optional Firehose
USE_FIREHOSE=false
FIREHOSE_STREAM=wikimedia-raw-firehose

# EC2 deploy
INSTANCE_PROFILE_NAME=LabInstanceProfile
EC2_INSTANCE_TYPE=t3.medium
EC2_KEY_NAME=
# AMI_ID=
# VPC_ID=
