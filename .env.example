AWS_REGION=eu-west-1

# Kinesis
KINESIS_STREAM=wikimedia-stream
KINESIS_SHARDS=2

# S3 bucket names (no s3:// prefix)
S3_RAW=wikimedia-pipeline-raw
S3_BATCH=wikimedia-pipeline-batch
S3_RAW_PREFIX=data/
S3_BATCH_PREFIX=output/

# DynamoDB speed view
DYNAMO_TABLE=wikimedia-speed-view

# EMR (set after infra/setup.py)
EMR_CLUSTER_ID=j-XXXXXXXXXXXX
EMR_MIN_INSTANCES=2
EMR_MAX_INSTANCES=8

# Athena / serving
ATHENA_DB=wikimedia_pipeline
ATHENA_TABLE=batch_view
ATHENA_KEYWORDS_TABLE=batch_keywords
ATHENA_HOURLY_TABLE=batch_hourly
S3_ATHENA_OUT=s3://wikimedia-pipeline-batch/athena-results/

# Ingestion
DATA_SOURCE=wikimedia
# DATA_SOURCE=usgs
# DATA_SOURCE=replay
REPLAY_FILE=data/sample_events.jsonl
REPLAY_RATE_HZ=10
WIKIMEDIA_URL=https://stream.wikimedia.org/v2/stream/recentchange

# Speed layer
WINDOW_SECONDS=300
TOP_N=10

# Raw S3 dual-write (batch layer input)
S3_RAW_FLUSH_SIZE=50
S3_RAW_FLUSH_SECONDS=10

# Optional Kinesis Firehose path
USE_FIREHOSE=false
FIREHOSE_STREAM=wikimedia-raw-firehose
